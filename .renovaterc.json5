{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "abandonments:recommended",
    ":skipStatusChecks",
    "github>solanyn/home-ops//.renovate/base.json5",
    "github>solanyn/home-ops//.renovate/autoMerge.json5",
    "github>solanyn/home-ops//.renovate/changelogs.json5",
    "github>solanyn/home-ops//.renovate/customManagers.json5",
    "github>solanyn/home-ops//.renovate/grafanaDashboards.json5",
    "github>solanyn/home-ops//.renovate/groups.json5",
    "github>solanyn/home-ops//.renovate/packageRules.json5",
    "github>solanyn/home-ops//.renovate/talosFactory.json5",
  ],
  ignorePaths: ["**/*.sops.*", "**/resources/**"],
  flux: {
    managerFilePatterns: ["/^kubernetes/.+\\.yaml(?:\\.j2)?$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/^kubernetes/.+\\.yaml(?:\\.j2)?$/"],
  },
  customManagers: [
    {
      customType: "regex",
      description: "LiteLLM version in the OpenCode Go user agent",
      managerFilePatterns: ["/^kubernetes/apps/ai/litellm/app/models/.+\\.yaml$/"],
      matchStrings: ["User-Agent: litellm/(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"],
      datasourceTemplate: "docker",
      depNameTemplate: "ghcr.io/berriai/litellm-database",
      versioningTemplate: "docker",
    },
  ],
  packageRules: [
    {
      description: "Hermes image bumps need a gateway/Matrix smoke check",
      matchDatasources: ["docker"],
      matchPackageNames: ["nousresearch/hermes-agent"],
      prBodyNotes: [
        "**After deploying, verify:** the gateway is up on the new tag (`hermes --version`), Matrix rooms still receive replies, and `hermes cron doctor` shows no delivery regressions. The `matrix_adapter_patch.py` init container is gone (E2EE is disabled in config), so there is no adapter anchor to re-check. Also expect a one-off `_config_version` migration from 44 upward on first start — the `init` container re-copies `resources/config.yaml` on every pod start, so capture the migrated file and commit it here rather than leaving it on the PVC.",
      ],
    },
  ],
}
