{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigestsToSemver",
    "mergeConfidence:all-badges",
    ":automergeBranch",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":timezone(Australia/Sydney)",
    "abandonments:recommended",
    ":skipStatusChecks",
    ":semanticCommits",
  ],
  ignorePaths: ["**/*.sops.*", "**/resources/**"],
  flux: {
    managerFilePatterns: ["/^kubernetes/.+\\.yaml(?:\\.j2)?$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/^kubernetes/.+\\.yaml(?:\\.j2)?$/"],
  },
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 3am on the first day of the month"],
  },
  suppressNotifications: ["prEditedNotification", "prIgnoreNotification"],
  mise: {
    enabled: true,
    managerFilePatterns: ["/(^|/)\\.mise/config\\.toml$/"],
  },
  customDatasources: {
    "grafana-dashboards": {
      defaultRegistryUrlTemplate: "https://grafana.com/api/dashboards/{{packageName}}",
      format: "json",
      transformTemplates: [
        '{"releases":[{"version": $string(revision)}], "sourceDirectory": name}',
      ],
    },
    "talos-factory": {
      defaultRegistryUrlTemplate: "https://factory.talos.dev/versions",
      format: "json",
      transformTemplates: ['{"releases": [$.{"version": $}]}'],
    },
  },
  customManagers: [
    {
      customType: "regex",
      description: "opencode plugins pinned in the ConfigMap JSON (no comments possible inside it)",
      managerFilePatterns: ["/(^|/)llm/opencode/configmap\\.yaml$/"],
      matchStrings: ['"(?<depName>@[^"/]+/[^"@]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"'],
      datasourceTemplate: "npm",
    },
    {
      customType: "regex",
      description: "Process annotated dependencies",
      managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+(:\\s|=)(&\\S+\\s)?[\"']?(?<currentValue>[^\"'\\s]+)[\"']?",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
    },
    {
      customType: "regex",
      description: "Process OCI dependencies",
      managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
      matchStrings: [
        "oci://(?<depName>[^:]+):(?<currentValue>\\S+)",
        "ref:\\s+tag:\\s*(?<currentValue>\\S+)\\s+url:\\s*oci://(?<depName>[^\\s]+)",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Talos machineconfig images",
      managerFilePatterns: ["/talos/.+\\.yaml\\.j2$/"],
      matchStrings: [
        "# renovate: datasource=docker depName=(?<depName>\\S+)\\nimage:\\s*(?<currentValue>.+)",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "MCP Server npm packages",
      managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
      matchStrings: ["npx\\s+-y\\s+(?<depName>@?[^@\\s]+)(?:@(?<currentValue>\\S+))?"],
      datasourceTemplate: "npm",
      versioningTemplate: "loose",
    },
    {
      description: "Process Grafana dashboards",
      customType: "regex",
      managerFilePatterns: ["/grafanadashboard\\.yaml(?:\\.j2)?$/"],
      matchStrings: [
        "dashboards\\/(?<depName>\\d+)\\/revisions\\/(?<currentValue>\\d+)\\/download",
      ],
      datasourceTemplate: "custom.grafana-dashboards",
      versioningTemplate: "regex:^(?<major>\\d+)$",
      autoReplaceStringTemplate: "dashboards/{{depName}}/revisions/{{newValue}}/download",
    },
    {
      description: "Process Talos Factory installer images",
      customType: "regex",
      managerFilePatterns: ["/talos\\/.*\\.yaml(?:\\.j2)?$/"],
      matchStrings: ["factory\\.talos\\.dev\\/[^/]+\\/[^:]+:(?<currentValue>v\\S+)"],
      datasourceTemplate: "custom.talos-factory",
      versioningTemplate: "semver",
      depNameTemplate: "siderolabs/talos",
    },
    {
      customType: "regex",
      description: "opencode plugins pinned in the ConfigMap JSON (no comments possible inside it)",
      managerFilePatterns: ["/(^|/)llm/opencode/configmap\\.yaml$/"],
      matchStrings: ['"(?<depName>@[^"/]+/[^"@]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"'],
      datasourceTemplate: "npm",
    },
    {
      customType: "regex",
      description: "Process annotated dependencies",
      managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+(:\\s|=)(&\\S+\\s)?[\"']?(?<currentValue>[^\"'\\s]+)[\"']?",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
    },
    {
      customType: "regex",
      description: "Process OCI dependencies",
      managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
      matchStrings: [
        "oci://(?<depName>[^:]+):(?<currentValue>\\S+)",
        "ref:\\s+tag:\\s*(?<currentValue>\\S+)\\s+url:\\s*oci://(?<depName>[^\\s]+)",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Talos machineconfig images",
      managerFilePatterns: ["/talos/.+\\.yaml\\.j2$/"],
      matchStrings: [
        "# renovate: datasource=docker depName=(?<depName>\\S+)\\nimage:\\s*(?<currentValue>.+)",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "MCP Server npm packages",
      managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
      matchStrings: ["npx\\s+-y\\s+(?<depName>@?[^@\\s]+)(?:@(?<currentValue>\\S+))?"],
      datasourceTemplate: "npm",
      versioningTemplate: "loose",
    },
    {
      description: "Process Grafana dashboards",
      customType: "regex",
      managerFilePatterns: ["/grafanadashboard\\.yaml(?:\\.j2)?$/"],
      matchStrings: [
        "dashboards\\/(?<depName>\\d+)\\/revisions\\/(?<currentValue>\\d+)\\/download",
      ],
      datasourceTemplate: "custom.grafana-dashboards",
      versioningTemplate: "regex:^(?<major>\\d+)$",
      autoReplaceStringTemplate: "dashboards/{{depName}}/revisions/{{newValue}}/download",
    },
    {
      description: "Process Talos Factory installer images",
      customType: "regex",
      managerFilePatterns: ["/talos\\/.*\\.yaml(?:\\.j2)?$/"],
      matchStrings: ["factory\\.talos\\.dev\\/[^/]+\\/[^:]+:(?<currentValue>v\\S+)"],
      datasourceTemplate: "custom.talos-factory",
      versioningTemplate: "semver",
      depNameTemplate: "siderolabs/talos",
    },
    {
      customType: "regex",
      description: "LiteLLM version in the OpenCode Go user agent",
      managerFilePatterns: ["/^kubernetes/apps/ai/litellm/app/models/.+\\.yaml$/"],
      matchStrings: ["User-Agent: litellm/(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"],
      datasourceTemplate: "docker",
      depNameTemplate: "ghcr.io/berriai/litellm-database",
      versioningTemplate: "docker",
    },
  ],
  packageRules: [
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
    {
      description: "Auto-merge trusted GitHub Actions",
      matchManagers: ["github-actions"],
      matchPackageNames: [
        "/^actions//",
        "/^anchore//",
        "/^docker//",
        "/^misospace/pr-reviewer-action$/",
        "/^renovatebot//",
        "/^sigstore//",
      ],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "1 minute",
      ignoreTests: true,
    },
    {
      description: "Auto-merge Mise Tools",
      matchManagers: ["mise"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch"],
      ignoreTests: true,
    },
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
    {
      matchDatasources: ["github-releases"],
      addLabels: ["renovate/github-release"],
    },
    {
      description: "Keep mise.lock up to date",
      matchManagers: ["mise"],
      lockFileMaintenance: {
        enabled: true,
      },
      postUpgradeTasks: {
        commands: ["mise install", "mise lock"],
        fileFilters: ["**/mise.lock"],
        executionMode: "branch",
      },
    },
    {
      description: ["Process terraform files"],
      matchManagers: ["terraform"],
      matchDatasources: ["terraform-provider"],
      registryUrls: ["https://registry.opentofu.org", "registry.terraform.io"],
      matchPackagePatterns: [".*"],
    },
    {
      matchUpdateTypes: ["major"],
      semanticCommitType: "feat",
      commitMessagePrefix: "{{semanticCommitType}}({{semanticCommitScope}})!:",
      commitMessageExtra: "({{currentVersion}} → {{newVersion}})",
    },
    {
      matchUpdateTypes: ["minor"],
      semanticCommitType: "feat",
      commitMessageExtra: "({{currentVersion}} → {{newVersion}})",
    },
    {
      matchUpdateTypes: ["patch"],
      semanticCommitType: "fix",
      commitMessageExtra: "({{currentVersion}} → {{newVersion}})",
    },
    {
      matchUpdateTypes: ["digest"],
      semanticCommitType: "chore",
      commitMessageExtra: "({{currentDigestShort}} → {{newDigestShort}})",
    },
    {
      matchDatasources: ["docker"],
      semanticCommitScope: "container",
      commitMessageTopic: "image {{depName}}",
    },
    {
      matchDatasources: ["helm"],
      semanticCommitScope: "helm",
      commitMessageTopic: "chart {{depName}}",
    },
    {
      matchManagers: ["github-actions"],
      semanticCommitType: "ci",
      semanticCommitScope: "github-action",
      commitMessageTopic: "action {{depName}}",
    },
    {
      matchDatasources: ["github-releases"],
      semanticCommitScope: "github-release",
      commitMessageTopic: "release {{depName}}",
    },
    {
      matchManagers: ["mise"],
      semanticCommitScope: "mise",
      commitMessageTopic: "tool {{depName}}",
    },
    {
      description: "Auto-merge trusted container digests",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["digest"],
      matchPackageNames: ["/home-operations/", "/solanyn/"],
      ignoreTests: false,
    },
    {
      description: "Auto-merge OCI Charts",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/kube-prometheus-stack/", "/grafana/"],
      ignoreTests: false,
    },
    {
      description: "Auto-merge GitHub Releases",
      matchDatasources: ["github-releases"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/external-dns/", "/gateway-api/", "/prometheus-operator/"],
      ignoreTests: true,
    },
    {
      description: "Auto merge minors and patches after minimumReleaseAge",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["ghcr.io/renovatebot/renovate"],
      ignoreTests: false,
    },
    {
      description: "Auto-merge solanyn containers",
      matchDatasources: ["docker"],
      matchPackageNames: ["/solanyn/"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Changelog URL for 1Password Connect",
      matchPackageNames: ["/1password/"],
      changelogUrl: "https://github.com/1Password/connect/blob/main/CHANGELOG.md",
    },
    {
      description: "Changelog URL for Cloudflared",
      matchPackageNames: ["/cloudflared/"],
      changelogUrl: "https://github.com/cloudflare/cloudflared/blob/master/RELEASE_NOTES",
    },
    {
      description: "Changelog URL for Spegel",
      matchPackageNames: ["/spegel/"],
      changelogUrl: "https://github.com/spegel-org/spegel/blob/main/CHANGELOG.md",
    },
    {
      addLabels: ["renovate/grafana-dashboard"],
      automerge: true,
      automergeType: "branch",
      commitMessageExtra: "({{currentVersion}} ➔ {{newVersion}})",
      commitMessageTopic: "dashboard {{sourceDirectory}}",
      ignoreTests: true,
      matchDatasources: ["custom.grafana-dashboards"],
      matchUpdateTypes: ["major"],
      semanticCommitScope: "grafana-dashboards",
      semanticCommitType: "chore",
    },
    {
      description: "LLMKube Group",
      groupName: "LLMKube",
      matchDatasources: ["docker"],
      matchPackageNames: ["/defilantech\\/charts\\//", "/llmkube/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Toolhive group",
      groupName: "Toolhive",
      matchDatasources: ["docker"],
      matchPackageNames: ["/toolhive-operator/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Towonel Group",
      groupName: "Towonel",
      matchDatasources: ["docker"],
      matchPackageNames: ["/towonel-(agent|node)/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Actions Runner Controller Group",
      groupName: "actions-runner-controller",
      matchDatasources: ["docker"],
      matchPackageNames: ["/gha-runner-scale-set-controller/", "/gha-runner-scale-set/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Cert-Manager Group",
      groupName: "cert-manager",
      matchDatasources: ["docker"],
      matchPackageNames: ["/cert-manager/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Cilium Group",
      groupName: "cilium",
      matchDatasources: ["docker"],
      matchPackageNames: ["/cilium/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "CoreDNS Group",
      groupName: "coredns",
      matchDatasources: ["docker"],
      matchPackageNames: ["/coredns/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "External Secrets Group",
      groupName: "external-secrets",
      matchDatasources: ["docker"],
      matchPackageNames: ["/external-secrets/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flink Kubernetes Operator Group",
      groupName: "flink-kubernetes-operator",
      matchDatasources: ["docker", "github-releases"],
      matchPackageNames: ["/flink-kubernetes-operator/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 4,
    },
    {
      description: "Kube Prometheus Stack Group",
      groupName: "kube-prometheus-stack",
      matchDatasources: ["docker"],
      matchPackageNames: ["/kube-prometheus-stack/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Kubernetes Group",
      groupName: "kubernetes",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 5,
    },
    {
      description: "Lake Group",
      groupName: "lake",
      matchDatasources: ["docker"],
      matchPackageNames: ["/solanyn/lake-/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Spegel Group",
      groupName: "spegel",
      matchDatasources: ["docker"],
      matchPackageNames: ["/spegel/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: ["Custom versioning for mylar3"],
      matchDatasources: ["docker"],
      versioning: "regex:^version-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      matchPackageNames: ["/mylar3/"],
    },
    {
      description: ["Custom regex versioning for kyuz0 amd-strix-halo-toolboxes rocm tags"],
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/kyuz0/amd-strix-halo-toolboxes"],
      versioning: "regex:^rocm-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      allowedVersions: "/^rocm-6\\./",
    },
    {
      description: ["Custom regex versioning for SearXNG CalVer SHA tags"],
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/searxng/searxng"],
      ignoreUnstable: false,
      versioning: "regex:^(?<major>\\d{4})\\.(?<minor>\\d{1,2})\\.(?<patch>\\d{1,2})-(?<prerelease>[0-9a-f]+)$",
    },
    {
      description: ["Hold kubectl-mcp-server at 1.24.0 (rohitg00#93 crashloop in toolhive)"],
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/rohitghumare64/kubectl-mcp-server"],
      enabled: false,
    },
    {
      description: "Release notes for metrics-server via ocharted",
      matchPackageNames: ["ocharted.jory.dev/kubernetes-sigs.github.io/metrics-server/**"],
      sourceUrl: "https://github.com/kubernetes-sigs/metrics-server",
    },
    {
      description: "Release notes for external-dns via ocharted",
      matchPackageNames: ["ocharted.jory.dev/kubernetes-sigs.github.io/external-dns/**"],
      sourceUrl: "https://github.com/kubernetes-sigs/external-dns",
    },
    {
      description: "Release notes for descheduler via ocharted",
      matchPackageNames: ["ocharted.jory.dev/kubernetes-sigs.github.io/descheduler/**"],
      sourceUrl: "https://github.com/kubernetes-sigs/descheduler",
    },
    {
      description: "Release notes for headlamp via ocharted",
      matchPackageNames: ["ocharted.jory.dev/kubernetes-sigs.github.io/headlamp/**"],
      sourceUrl: "https://github.com/kubernetes-sigs/headlamp",
    },
    {
      description: "Release notes for nvidia-device-plugin via ocharted",
      matchPackageNames: ["ocharted.jory.dev/nvidia.github.io/k8s-device-plugin/**"],
      sourceUrl: "https://github.com/NVIDIA/k8s-device-plugin",
    },
    {
      description: "Release notes for ceph-csi-drivers via ocharted",
      matchPackageNames: ["ocharted.jory.dev/ceph.github.io/ceph-csi-operator/**"],
      sourceUrl: "https://github.com/ceph/ceph-csi-operator",
    },
    {
      description: "Release notes for k8s-gpu-dra-driver via ocharted",
      matchPackageNames: ["ocharted.jory.dev/rocm.github.io/k8s-gpu-dra-driver/**"],
      sourceUrl: "https://github.com/ROCm/k8s-gpu-dra-driver",
    },
    {
      addLabels: ["renovate/talos"],
      matchDatasources: ["custom.talos-factory"],
      semanticCommitScope: "container",
      commitMessageTopic: "{{depName}}",
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
    {
      description: "Auto-merge trusted GitHub Actions",
      matchManagers: ["github-actions"],
      matchPackageNames: [
        "/^actions//",
        "/^anchore//",
        "/^docker//",
        "/^misospace/pr-reviewer-action$/",
        "/^renovatebot//",
        "/^sigstore//",
      ],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "1 minute",
      ignoreTests: true,
    },
    {
      description: "Auto-merge Mise Tools",
      matchManagers: ["mise"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch"],
      ignoreTests: true,
    },
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
    {
      matchDatasources: ["github-releases"],
      addLabels: ["renovate/github-release"],
    },
    {
      description: "Keep mise.lock up to date",
      matchManagers: ["mise"],
      lockFileMaintenance: {
        enabled: true,
      },
      postUpgradeTasks: {
        commands: ["mise install", "mise lock"],
        fileFilters: ["**/mise.lock"],
        executionMode: "branch",
      },
    },
    {
      description: ["Process terraform files"],
      matchManagers: ["terraform"],
      matchDatasources: ["terraform-provider"],
      registryUrls: ["https://registry.opentofu.org", "registry.terraform.io"],
      matchPackagePatterns: [".*"],
    },
    {
      matchUpdateTypes: ["major"],
      semanticCommitType: "feat",
      commitMessagePrefix: "{{semanticCommitType}}({{semanticCommitScope}})!:",
      commitMessageExtra: "({{currentVersion}} → {{newVersion}})",
    },
    {
      matchUpdateTypes: ["minor"],
      semanticCommitType: "feat",
      commitMessageExtra: "({{currentVersion}} → {{newVersion}})",
    },
    {
      matchUpdateTypes: ["patch"],
      semanticCommitType: "fix",
      commitMessageExtra: "({{currentVersion}} → {{newVersion}})",
    },
    {
      matchUpdateTypes: ["digest"],
      semanticCommitType: "chore",
      commitMessageExtra: "({{currentDigestShort}} → {{newDigestShort}})",
    },
    {
      matchDatasources: ["docker"],
      semanticCommitScope: "container",
      commitMessageTopic: "image {{depName}}",
    },
    {
      matchDatasources: ["helm"],
      semanticCommitScope: "helm",
      commitMessageTopic: "chart {{depName}}",
    },
    {
      matchManagers: ["github-actions"],
      semanticCommitType: "ci",
      semanticCommitScope: "github-action",
      commitMessageTopic: "action {{depName}}",
    },
    {
      matchDatasources: ["github-releases"],
      semanticCommitScope: "github-release",
      commitMessageTopic: "release {{depName}}",
    },
    {
      matchManagers: ["mise"],
      semanticCommitScope: "mise",
      commitMessageTopic: "tool {{depName}}",
    },
    {
      description: "Auto-merge trusted container digests",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["digest"],
      matchPackageNames: ["/home-operations/", "/solanyn/"],
      ignoreTests: false,
    },
    {
      description: "Auto-merge OCI Charts",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/kube-prometheus-stack/", "/grafana/"],
      ignoreTests: false,
    },
    {
      description: "Auto-merge GitHub Releases",
      matchDatasources: ["github-releases"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/external-dns/", "/gateway-api/", "/prometheus-operator/"],
      ignoreTests: true,
    },
    {
      description: "Auto merge minors and patches after minimumReleaseAge",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["ghcr.io/renovatebot/renovate"],
      ignoreTests: false,
    },
    {
      description: "Auto-merge solanyn containers",
      matchDatasources: ["docker"],
      matchPackageNames: ["/solanyn/"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Changelog URL for 1Password Connect",
      matchPackageNames: ["/1password/"],
      changelogUrl: "https://github.com/1Password/connect/blob/main/CHANGELOG.md",
    },
    {
      description: "Changelog URL for Cloudflared",
      matchPackageNames: ["/cloudflared/"],
      changelogUrl: "https://github.com/cloudflare/cloudflared/blob/master/RELEASE_NOTES",
    },
    {
      description: "Changelog URL for Spegel",
      matchPackageNames: ["/spegel/"],
      changelogUrl: "https://github.com/spegel-org/spegel/blob/main/CHANGELOG.md",
    },
    {
      addLabels: ["renovate/grafana-dashboard"],
      automerge: true,
      automergeType: "branch",
      commitMessageExtra: "({{currentVersion}} ➔ {{newVersion}})",
      commitMessageTopic: "dashboard {{sourceDirectory}}",
      ignoreTests: true,
      matchDatasources: ["custom.grafana-dashboards"],
      matchUpdateTypes: ["major"],
      semanticCommitScope: "grafana-dashboards",
      semanticCommitType: "chore",
    },
    {
      description: "LLMKube Group",
      groupName: "LLMKube",
      matchDatasources: ["docker"],
      matchPackageNames: ["/defilantech\\/charts\\//", "/llmkube/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Toolhive group",
      groupName: "Toolhive",
      matchDatasources: ["docker"],
      matchPackageNames: ["/toolhive-operator/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Towonel Group",
      groupName: "Towonel",
      matchDatasources: ["docker"],
      matchPackageNames: ["/towonel-(agent|node)/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Actions Runner Controller Group",
      groupName: "actions-runner-controller",
      matchDatasources: ["docker"],
      matchPackageNames: ["/gha-runner-scale-set-controller/", "/gha-runner-scale-set/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Cert-Manager Group",
      groupName: "cert-manager",
      matchDatasources: ["docker"],
      matchPackageNames: ["/cert-manager/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Cilium Group",
      groupName: "cilium",
      matchDatasources: ["docker"],
      matchPackageNames: ["/cilium/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "CoreDNS Group",
      groupName: "coredns",
      matchDatasources: ["docker"],
      matchPackageNames: ["/coredns/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "External Secrets Group",
      groupName: "external-secrets",
      matchDatasources: ["docker"],
      matchPackageNames: ["/external-secrets/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flink Kubernetes Operator Group",
      groupName: "flink-kubernetes-operator",
      matchDatasources: ["docker", "github-releases"],
      matchPackageNames: ["/flink-kubernetes-operator/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 4,
    },
    {
      description: "Kube Prometheus Stack Group",
      groupName: "kube-prometheus-stack",
      matchDatasources: ["docker"],
      matchPackageNames: ["/kube-prometheus-stack/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Kubernetes Group",
      groupName: "kubernetes",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 5,
    },
    {
      description: "Lake Group",
      groupName: "lake",
      matchDatasources: ["docker"],
      matchPackageNames: ["/solanyn/lake-/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Spegel Group",
      groupName: "spegel",
      matchDatasources: ["docker"],
      matchPackageNames: ["/spegel/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: ["Custom versioning for mylar3"],
      matchDatasources: ["docker"],
      versioning: "regex:^version-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      matchPackageNames: ["/mylar3/"],
    },
    {
      description: ["Custom regex versioning for kyuz0 amd-strix-halo-toolboxes rocm tags"],
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/kyuz0/amd-strix-halo-toolboxes"],
      versioning: "regex:^rocm-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      allowedVersions: "/^rocm-6\\./",
    },
    {
      description: ["Custom regex versioning for SearXNG CalVer SHA tags"],
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/searxng/searxng"],
      ignoreUnstable: false,
      versioning: "regex:^(?<major>\\d{4})\\.(?<minor>\\d{1,2})\\.(?<patch>\\d{1,2})-(?<prerelease>[0-9a-f]+)$",
    },
    {
      description: ["Hold kubectl-mcp-server at 1.24.0 (rohitg00#93 crashloop in toolhive)"],
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/rohitghumare64/kubectl-mcp-server"],
      enabled: false,
    },
    {
      description: "Release notes for metrics-server via ocharted",
      matchPackageNames: ["ocharted.jory.dev/kubernetes-sigs.github.io/metrics-server/**"],
      sourceUrl: "https://github.com/kubernetes-sigs/metrics-server",
    },
    {
      description: "Release notes for external-dns via ocharted",
      matchPackageNames: ["ocharted.jory.dev/kubernetes-sigs.github.io/external-dns/**"],
      sourceUrl: "https://github.com/kubernetes-sigs/external-dns",
    },
    {
      description: "Release notes for descheduler via ocharted",
      matchPackageNames: ["ocharted.jory.dev/kubernetes-sigs.github.io/descheduler/**"],
      sourceUrl: "https://github.com/kubernetes-sigs/descheduler",
    },
    {
      description: "Release notes for headlamp via ocharted",
      matchPackageNames: ["ocharted.jory.dev/kubernetes-sigs.github.io/headlamp/**"],
      sourceUrl: "https://github.com/kubernetes-sigs/headlamp",
    },
    {
      description: "Release notes for nvidia-device-plugin via ocharted",
      matchPackageNames: ["ocharted.jory.dev/nvidia.github.io/k8s-device-plugin/**"],
      sourceUrl: "https://github.com/NVIDIA/k8s-device-plugin",
    },
    {
      description: "Release notes for ceph-csi-drivers via ocharted",
      matchPackageNames: ["ocharted.jory.dev/ceph.github.io/ceph-csi-operator/**"],
      sourceUrl: "https://github.com/ceph/ceph-csi-operator",
    },
    {
      description: "Release notes for k8s-gpu-dra-driver via ocharted",
      matchPackageNames: ["ocharted.jory.dev/rocm.github.io/k8s-gpu-dra-driver/**"],
      sourceUrl: "https://github.com/ROCm/k8s-gpu-dra-driver",
    },
    {
      addLabels: ["renovate/talos"],
      matchDatasources: ["custom.talos-factory"],
      semanticCommitScope: "container",
      commitMessageTopic: "{{depName}}",
    },
    {
      description: "Hermes image bumps need the Matrix adapter patch check",
      matchDatasources: ["docker"],
      matchPackageNames: ["nousresearch/hermes-agent"],
      prBodyNotes: [
        "**Matrix adapter patch:** the bundled Matrix plugin is patched at pod start by `resources/matrix_adapter_patch.py`. After deploying, check `kubectl logs -n ai deploy/hermes -c patch-matrix-adapter` for `key-share backfill enabled`. If it reports `anchor not found`, update the anchor for the new adapter before trusting message delivery, and drop the patch if upstream now answers cross-user key requests.",
      ],
    },
  ],
}
