{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  customManagers: [
    {
      customType: "regex",
      description: "Track Kubeflow manifests version",
      fileMatch: ["^third_party/kubeflow/manifests/\\.last-upstream-ref$"],
      matchStrings: ["^(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\s*$"],
      datasourceTemplate: "github-releases",
      depNameTemplate: "kubeflow/manifests",
      versioningTemplate: "semver",
    },
    {
      customType: "regex",
      description: "Track openclaw-sandbox image version",
      managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
      matchStrings: ['ghcr\\.io/solanyn/openclaw-sandbox:(?<currentValue>[^"@\\s]+)'],
      depNameTemplate: "ghcr.io/solanyn/openclaw-sandbox",
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Track Flink Kubernetes Operator version in HelmRepository URL",
      fileMatch: ["kubernetes/apps/streaming/flink/.*\\.yaml$"],
      matchStrings: [
        "url: https://downloads\\.apache\\.org/flink/flink-kubernetes-operator-(?<currentValue>[\\d.]+)/",
      ],
      datasourceTemplate: "github-releases",
      depNameTemplate: "apache/flink-kubernetes-operator",
      extractVersionTemplate: "^release-(?<version>.*)$",
    },
  ],
}
