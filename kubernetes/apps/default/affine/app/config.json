{
  "$schema": "https://github.com/toeverything/affine/releases/download/v0.27.4/config.schema.json",
  "server": {
    "name": "AFFiNE",
    "externalUrl": "https://affine.goyangi.io"
  },
  "copilot": {
    "enabled": false,
    "byok": {
      "enabled": false
    }
  },
  "storages": {
    "avatar.storage": {
      "provider": "fs",
      "bucket": "avatars",
      "config": {
        "path": "/root/.affine/storage"
      }
    },
    "blob.storage": {
      "provider": "fs",
      "bucket": "blobs",
      "config": {
        "path": "/root/.affine/storage"
      }
    },
    "copilot.storage": {
      "provider": "fs",
      "bucket": "copilot",
      "config": {
        "path": "/root/.affine/storage"
      }
    }
  }
}
